#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

#define MOUSE 1
#define SCROLL 2
#define NUM 6

// OS設定を日本語キーボードのまま使用するための変換定義

#define JP_ZKHK  GRAVE        // Zenkaku ↔ Hankaku ↔ Kanji (半角 ↔ 全角 ↔ 漢字)
#define JP_MINUS MINUS        // -
#define JP_CARET EQUAL        // ^
#define JP_YEN   INT3         // ¥
#define JP_AT    LBKT         // @
#define JP_LBKT  RBKT         // [
#define JP_EISU  CAPS         // Eisū (英数)
#define JP_SEMI  SEMI         // ;
#define JP_COLON SQT          // :
#define JP_RBKT  NUHS         // ]
#define JP_COMMA COMMA        // ,
#define JP_DOT   DOT          // .
#define JP_SLASH SLASH        // /
#define JP_BSLH  INT1         // (backslash)
#define JP_MHEN  INT5         // Muhenkan (無変換)
#define JP_HENK  INT4         // Henkan (変換)
#define JP_KANA  INT2         // Katakana ↔ Hiragana ↔ Rōmaji (カタカナ ↔ ひらがな ↔ ローマ字)
#define JP_EXCL  LS(N1)       // !
#define JP_DQT   LS(N2)       // "
#define JP_HASH  LS(N3)       // #
#define JP_DLLR  LS(N4)       // $
#define JP_PRCNT LS(N5)       // %
#define JP_AMPS  LS(N6)       // &
#define JP_SQT   LS(N7)       // '
#define JP_LPAR  LS(N8)       // (
#define JP_RPAR  LS(N9)       // )
#define JP_EQUAL LS(JP_MINUS) // =
#define JP_TILDE LS(JP_CARET) // ~
#define JP_PIPE  LS(JP_YEN)   // |
#define JP_GRAVE LS(JP_AT)    // `
#define JP_LBRC  LS(JP_LBKT)  // {
#define JP_CAPS  LS(JP_EISU)  // Caps Lock
#define JP_PLUS  LS(JP_SEMI)  // +
#define JP_ASTRK LS(JP_COLON) // *
#define JP_RBRC  LS(JP_RBKT)  // }
#define JP_LT    LS(JP_COMMA) // <
#define JP_RT    LS(JP_DOT)   // >
#define JP_QMARK LS(JP_SLASH) // ?
#define JP_UNDER LS(JP_BSLH)  // _

&mt {
    flavor = "balanced";
    quick-tap-ms = <0>;
    tapping-term-ms = <180>;
};

&sl { release-after-ms = <250>; }; // ダブルクリックに必要な時間を設定
/ {
    combos { compatible = "zmk,combos"; };

    macros {
        to_layer_0: to_layer_0 {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings = <&to 1 &macro_param_1to1 &kp MACRO_PLACEHOLDER>;
            label = "TO_LAYER_0";
        };

        shift_macro: shift_macro {
            compatible = "zmk,behavior-macro-one-param";
            label = "SHIFT_MACRO";
            #binding-cells = <1>;
            bindings = <&kp LS(LEFT_SHIFT) &macro_param_1to1 &kp MACRO_PLACEHOLDER &kp LS(LEFT_SHIFT)>;
        };
    };

    behaviors {
        lt_to_layer_0: lt_to_layer_0 {
            compatible = "zmk,behavior-hold-tap";
            label = "LAYER_TAP_TO_0";
            bindings = <&mo>, <&to_layer_0>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
        };

        lbkt_td_behavior: lbkt_td_behavior {
            compatible = "zmk,behavior-tap-dance";
            label = "LBKT_TD_BEHAVIOR";
            #binding-cells = <0>;
            bindings = <&kp JP_LBKT>, <&kp LS(N8)>;
        };

        rbkt_td_behavior: rbkt_td_behavior {
            compatible = "zmk,behavior-tap-dance";
            label = "RBKT_TD_BEHAVIOR";
            #binding-cells = <0>;
            bindings = <&kp JP_RBKT>, <&kp LS(N9)>;
        };

        lang_td_behavior: lang_td_behavior {
            compatible = "zmk,behavior-tap-dance";
            label = "LANG_TD_BEHAVIOR";
            #binding-cells = <0>;
            bindings = <&mt LCTRL LANGUAGE_2>, <&mt LCTRL LANGUAGE_1>;

            tapping-term-ms = <230>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        df {
            bindings = <
&kp Q       &kp W         &kp E         &kp R        &kp T                                                                &kp Y        &kp U  &kp I      &kp O    &kp P
&kp A       &kp S         &kp D         &kp F        &kp G               &kp C_MUTE             &lt 5 LA(LG(K))           &kp H        &kp J  &kp K      &kp L    &lt 4 MINUS
&kp Z       &kp X         &kp C         &kp V        &kp B               &lbkt_td_behavior      &rbkt_td_behavior         &kp N        &kp M  &kp COMMA  &kp DOT  &kp SLASH
&kp ESCAPE  &kp LEFT_WIN  &kp LEFT_ALT  &lt 1 SPACE  &mt LEFT_SHIFT TAB  &lang_td_behavior      &mt LEFT_SHIFT BACKSPACE  &lt 2 ENTER                             &kp JP_YEN
            >;

            sensor-bindings = <&inc_dec_kp C_VOLUME_DOWN C_VOLUME_UP>;
        };

        mouse_symbol {
            bindings = <
&kp LG(LS(S))  &kp LC(TAB)  &kp LC(LA(TAB))  &mkp MB5  &trans                      &kp LS(N7)            &kp LS(SEMICOLON)  &kp LS(SQT)  &kp EQUAL         &kp LEFT_BRACKET
&mo 4          &mkp MB2     &mkp MB3         &mkp MB1  &trans  &trans      &trans  &kp LS(NUMBER_2)      &kp SEMICOLON      &kp SQT      &kp LS(NUMBER_1)  &mo 4
&trans         &trans       &trans           &mkp MB4  &trans  &trans      &trans  &kp LS(LEFT_BRACKET)  &kp LS(NUMBER_3)   &kp LS(N5)   &kp LS(NUMBER_4)  &kp LS(NUMBER_6)
&trans         &trans       &trans           &trans    &trans  &trans      &trans  &trans                                                                  &kp JP_UNDER
            >;

            sensor-bindings = <&inc_dec_kp PAGE_DOWN PAGE_UP>;
        };

        number_arrow {
            bindings = <
&kp LS(EQUAL)  &kp N7        &kp N8        &kp N9        &kp LS(SEMICOLON)                                          &none   &none     &none         &none          &none
&kp SLASH      &kp NUMBER_4  &kp N5        &kp NUMBER_6  &kp LS(SINGLE_QUOTE)  &kp LC(LA(KP_NUMBER_0))      &none   &none   &kp LEFT  &kp UP_ARROW  &kp DOWN       &kp RIGHT
&kp NUMBER_0   &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp PERIOD            &kp COMMA                    &none   &none   &kp HOME  &kp PAGE_UP   &kp PAGE_DOWN  &kp END
&trans         &trans        &trans        &trans        &trans                &trans                       &trans  &trans                                         &none
            >;
        };

        function {
            bindings = <
&kp F9  &kp F10  &kp F11  &kp F12  &none                       &trans  &trans  &trans  &trans  &trans
&kp F5  &kp F6   &kp F7   &kp F8   &none   &trans      &trans  &trans  &trans  &trans  &trans  &trans
&kp F1  &kp F2   &kp F3   &kp F4   &none   &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans   &trans   &trans   &trans  &trans      &trans  &trans                          &trans
            >;
        };

        scl {
            bindings = <
&none  &none     &none     &mkp MB5  &none                        &none   &mkp MB5  &none     &none     &none
&none  &mkp MB2  &mkp MB3  &mkp MB1  &none   &none       &none    &none   &mkp MB1  &mkp MB3  &mkp MB2  &none
&none  &none     &none     &mkp MB4  &none   &none       &none    &none   &mkp MB4  &none     &none     &none
&none  &none     &none     &trans    &trans  &trans      &kp DEL  &trans                                &none
            >;
        };

        blt {
            bindings = <
&trans        &trans        &trans        &trans        &trans                                 &trans  &trans  &trans  &trans  &trans
&bt BT_SEL 4  &bt BT_SEL 3  &bt BT_SEL 2  &bt BT_SEL 1  &bt BT_SEL 0  &trans      &trans       &trans  &trans  &trans  &trans  &trans
&trans        &trans        &trans        &trans        &trans        &trans      &bootloader  &trans  &trans  &trans  &trans  &bt BT_CLR
&trans        &trans        &trans        &trans        &trans        &trans      &trans       &trans                          &bt BT_CLR_ALL
            >;
        };
    };

    conditional_layers {
        compatible = "zmk,conditional-layers";

        blt_layer {
            if-layers = <1 2>;
            then-layer = <3>;
        };
    };
};
